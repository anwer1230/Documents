<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#17212B">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚨 المراقبة ورصد الكلمات المفتاحية"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تشغيل المراقبة في الخلفية"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/monitor_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <EditText
        android:id="@+id/keywords_input"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="top"
        android:hint="أدخل الكلمات المفتاحية مفصولة بفواصل (مثال: وظيفة, مطلوب, برمجة)"
        android:textColor="#FFFFFF"
        android:textColorHint="#7F8C8D"
        android:background="#242F3D"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حفظ وتفعيل الرصد"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5288C1"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/logs_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0E1621"
        android:padding="12dp"
        android:text="سجل التنبيهات المباشرة:\nيتم تحويل أي كلمة مرصودة تلقائياً إلى الرسائل المحفوظة (Saved Messages)..."
        android:textColor="#BDC3C7"
        android:textSize="13sp" />

</LinearLayout>
