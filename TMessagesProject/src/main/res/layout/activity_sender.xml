<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#17212B">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الإرسال الذكي والمجدول (Smart Sender)"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/target_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="رابط المجموعة (@username أو t.me/+hash أو Chat ID)"
        android:textColor="#FFFFFF"
        android:textColorHint="#7F8C8D"
        android:background="#242F3D"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/message_input"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="top"
        android:hint="اكتب نص الرسالة هنا..."
        android:textColor="#FFFFFF"
        android:textColorHint="#7F8C8D"
        android:background="#242F3D"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/send_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚀 إرسال فوري مع بروتوكول السلام"
        android:textColor="#FFFFFF"
        android:backgroundTint="#5288C1"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/schedule_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏱️ تفعيل الجدولة الدورية (كل 3 دقائق)"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2B5278"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/status_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الحالة: جاهز للعمل"
        android:textColor="#2ECC71"
        android:gravity="center" />

</LinearLayout>
