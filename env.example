# ══════════════════════════════════════════════════════
#  متغيرات البيئة — مركز سرعة انجاز للخدمات
#  أضف هذه المتغيرات في لوحة Render > Environment
# ══════════════════════════════════════════════════════

# منفذ التشغيل (يُعيَّن تلقائياً من Render - لا تغيّره)
PORT=10000

# وضع Render (اتركه true عند النشر)
RENDER=true

# إعدادات Telegram API
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# مفتاح الجلسة الأمني — غيّره لقيمة عشوائية طويلة
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_HERE

# مفتاح Groq AI — احصل عليه من console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# إعدادات GitHub (لحفظ الجلسات في المستودع)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=anwer1230/Abu_Mlk
GITHUB_BRANCH=main

# مفاتيح إشعارات المتصفح (اختيارية)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_B64=your_vapid_private_key_base64_here
